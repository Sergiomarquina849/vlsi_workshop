  input [1:0] baud_rate;
  input [7:0] data_in;
  input reset_n, send, clock;
  output data_tx, active_flag, done_flag;
  wire   baud_clk_w, n1, n2;

  INVX2_RVT U1 ( .A(n2), .Y(n1) );
  INVX0_RVT U2 ( .A(reset_n), .Y(n2) );
  BaudGenT Unit1 ( .reset_n(n1), .clock(clock), .baud_rate(baud_rate), 
        .baud_clk(baud_clk_w) );
  PISO Unit3 ( .reset_n(n1), .send(send), .baud_clk(baud_clk_w), .parity_bit(
        1'b0), .parity_type({1'b0, 1'b0}), .data_in({1'b0, 1'b0, 1'b0, 1'b0, 
        1'b0, 1'b0, 1'b0, 1'b0}), .data_tx(data_tx), .active_flag(active_flag), 
        .done_flag(done_flag) );
