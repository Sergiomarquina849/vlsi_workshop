module DeFrame ( reset_n, recieved_flag, data_parll, parity_bit, start_bit, 
        stop_bit, done_flag, raw_data );
  input [10:0] data_parll;
  output [7:0] raw_data;
  input reset_n, recieved_flag;
  output parity_bit, start_bit, stop_bit, done_flag;
  wire   n3, n1, n2;

  OR2X1_RVT U5 ( .A1(data_parll[10]), .A2(n3), .Y(stop_bit) );
  AND2X1_RVT U6 ( .A1(data_parll[0]), .A2(n2), .Y(start_bit) );
  OR2X1_RVT U7 ( .A1(data_parll[8]), .A2(n3), .Y(raw_data[7]) );
  OR2X1_RVT U8 ( .A1(data_parll[7]), .A2(n3), .Y(raw_data[6]) );
  OR2X1_RVT U9 ( .A1(data_parll[6]), .A2(n3), .Y(raw_data[5]) );
  OR2X1_RVT U10 ( .A1(data_parll[5]), .A2(n3), .Y(raw_data[4]) );
  OR2X1_RVT U11 ( .A1(data_parll[4]), .A2(n3), .Y(raw_data[3]) );
  OR2X1_RVT U12 ( .A1(data_parll[3]), .A2(n3), .Y(raw_data[2]) );
  OR2X1_RVT U13 ( .A1(data_parll[2]), .A2(n3), .Y(raw_data[1]) );
  OR2X1_RVT U14 ( .A1(data_parll[1]), .A2(n3), .Y(raw_data[0]) );
  OR2X1_RVT U15 ( .A1(data_parll[9]), .A2(n3), .Y(parity_bit) );
  NAND2X0_RVT U17 ( .A1(reset_n), .A2(n1), .Y(done_flag) );
  INVX0_RVT U4 ( .A(recieved_flag), .Y(n1) );
  INVX0_RVT U16 ( .A(n3), .Y(n2) );
  NAND2X1_RVT U3 ( .A1(reset_n), .A2(recieved_flag), .Y(n3) );
endmodule


module ErrorCheck ( reset_n, recieved_flag, parity_bit, start_bit, stop_bit, 
        parity_type, raw_data, error_flag );
  input [1:0] parity_type;
  input [7:0] raw_data;
  output [2:0] error_flag;
  input reset_n, recieved_flag, parity_bit, start_bit, stop_bit;
  wire   n3, n4, n5, n6, n7, n8, n9, n10, n11, n1, n2;

  NOR2X1_RVT U8 ( .A1(stop_bit), .A2(n3), .Y(error_flag[2]) );
  AND2X1_RVT U9 ( .A1(start_bit), .A2(n1), .Y(error_flag[1]) );
  AND2X1_RVT U10 ( .A1(n1), .A2(n4), .Y(error_flag[0]) );
  NAND3X0_RVT U11 ( .A1(n5), .A2(n6), .A3(parity_bit), .Y(n4) );
  NAND3X0_RVT U12 ( .A1(n7), .A2(n2), .A3(parity_type[1]), .Y(n6) );
  OR3X1_RVT U13 ( .A1(n7), .A2(parity_type[1]), .A3(n2), .Y(n5) );
  XNOR3X1_RVT U14 ( .A1(raw_data[5]), .A2(raw_data[4]), .A3(n10), .Y(n9) );
  XNOR3X1_RVT U15 ( .A1(raw_data[1]), .A2(raw_data[0]), .A3(n11), .Y(n8) );
  NAND2X0_RVT U16 ( .A1(reset_n), .A2(recieved_flag), .Y(n3) );
  INVX0_RVT U3 ( .A(n3), .Y(n1) );
  XOR2X1_RVT U4 ( .A1(n8), .A2(n9), .Y(n7) );
  XOR2X1_RVT U5 ( .A1(raw_data[3]), .A2(raw_data[2]), .Y(n11) );
  XNOR2X1_RVT U6 ( .A1(raw_data[7]), .A2(raw_data[6]), .Y(n10) );
  INVX0_RVT U7 ( .A(parity_type[0]), .Y(n2) );
endmodule


module RxUnit ( reset_n, data_tx, clock, parity_type, baud_rate, active_flag, 
        done_flag, error_flag, data_out );
  input [1:0] parity_type;
  input [1:0] baud_rate;
  output [2:0] error_flag;
  output [7:0] data_out;
  input reset_n, data_tx, clock;
  output active_flag, done_flag;
  wire   baud_clk_w, recieved_flag_w, def_par_bit_w, def_strt_bit_w,
         def_stp_bit_w;
  wire   [10:0] data_parll_w;

  BaudGenR Unit1 ( .reset_n(reset_n), .clock(clock), .baud_rate(baud_rate), 
        .baud_clk(baud_clk_w) );
  SIPO Unit2 ( .reset_n(reset_n), .data_tx(data_tx), .baud_clk(baud_clk_w), 
        .active_flag(active_flag), .recieved_flag(recieved_flag_w), 
        .data_parll(data_parll_w) );
  DeFrame Unit3 ( .reset_n(reset_n), .recieved_flag(recieved_flag_w), 
        .data_parll(data_parll_w), .parity_bit(def_par_bit_w), .start_bit(
        def_strt_bit_w), .stop_bit(def_stp_bit_w), .done_flag(done_flag), 
        .raw_data(data_out) );
  ErrorCheck Unit4 ( .reset_n(reset_n), .recieved_flag(done_flag), 
        .parity_bit(def_par_bit_w), .start_bit(def_strt_bit_w), .stop_bit(
        def_stp_bit_w), .parity_type(parity_type), .raw_data(data_out), 
        .error_flag(error_flag) );
endmodule


module Duplex ( reset_n, send, clock, parity_type, baud_rate, data_in, 
        tx_active_flag, tx_done_flag, rx_active_flag, rx_done_flag, data_out, 
        error_flag );
  input [1:0] parity_type;
  input [1:0] baud_rate;
  input [7:0] data_in;
  output [7:0] data_out;
  output [2:0] error_flag;
  input reset_n, send, clock;
  output tx_active_flag, tx_done_flag, rx_active_flag, rx_done_flag;
  wire   data_tx_w;

  TxUnit Transmitter ( .reset_n(reset_n), .send(send), .clock(clock), 
        .parity_type({1'b0, 1'b0}), .baud_rate(baud_rate), .data_in({1'b0, 
        1'b0, 1'b0, 1'b0, 1'b0, 1'b0, 1'b0, 1'b0}), .data_tx(data_tx_w), 
        .active_flag(tx_active_flag), .done_flag(tx_done_flag) );
  RxUnit Reciever ( .reset_n(reset_n), .data_tx(data_tx_w), .clock(clock), 
        .parity_type(parity_type), .baud_rate(baud_rate), .active_flag(
        rx_active_flag), .done_flag(rx_done_flag), .error_flag(error_flag), 
        .data_out(data_out) );
endmodule
